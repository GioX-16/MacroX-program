<UserControl x:Class="macrox.Views.ExcelWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentControl Style="{StaticResource GlassCardStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel LastChildFill="False">
                    <Button Margin="0,0,12,0"
                            Command="{Binding OpenCommand}"
                            Content="Importar Excel"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="0,0,12,0"
                            Command="{Binding ApplyCommand}"
                            Content="Aplicar y generar archivo"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <ComboBox MinWidth="160"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SheetNames}"
                              SelectedItem="{Binding SelectedSheetName, Mode=TwoWay}"
                              Visibility="{Binding HasWorkbook, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding FileName}" />
                </DockPanel>

                <TextBlock Margin="0,16,0,8"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="Todavía no hay Excel importados."
                           Visibility="{Binding HasNoImportedBooks, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding ImportedBooks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        AutomationProperties.Name="Eliminar Excel"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Eliminar">
                                    <TextBlock FontFamily="{StaticResource FontFamilyIcons}"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </Button>
                                <Button HorizontalContentAlignment="Left"
                                        Command="{Binding OpenCommand}"
                                        Content="{Binding FileName}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasWorkbook, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Marca una o varias macros y pulsa Aplicar y generar archivo. Si marcas Separar por columna, elige la columna. Después guardas el Excel nuevo, por ejemplo en Descargas."
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Macros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4"
                                          Content="{Binding DisplayName}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,12,0,0"
                               LastChildFill="True"
                               Visibility="{Binding NeedsColumnChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Columna para separar" />
                        <ComboBox MinWidth="180"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding ColumnHeaders}"
                                  SelectedItem="{Binding SelectedSplitColumn, Mode=TwoWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="No hay macros en la biblioteca. Trim se quitó; puedes volver a mostrarla."
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNoMacros, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding RestoreMacrosCommand}"
                            Content="Restaurar macros"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding HasNoMacros, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ApplyCommand}"
                            Content="Aplicar y generar archivo"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <Border Margin="0,16,0,8"
                        Padding="12"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding ResultBanner}"
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock Margin="0,8,0,8"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding PreviewCaption}"
                           Visibility="{Binding HasWorkbook, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,0,0,12"
                           Foreground="{StaticResource FocusBrush}"
                           Text="{Binding ResultLabel}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Importa el Excel para añadirlo. La tabla y el archivo nuevo se ven aquí, sin salir de MacroX."
                       TextWrapping="Wrap"
                       Visibility="{Binding HasNoWorkbook, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <DataGrid x:Name="SheetGrid"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="SheetGrid_OnAutoGeneratingColumn"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding TableView}"
                      MaxHeight="420"
                      Visibility="{Binding HasWorkbook, Converter={StaticResource BooleanToVisibilityConverter}}"
                      MinHeight="180"
                      Style="{StaticResource SheetGridStyle}" />
        </DockPanel>
    </ContentControl>
</UserControl>
