<UserControl x:Class="macrox.Views.MacroLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentControl Style="{StaticResource GlassCardStyle}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ImportCommand}"
                        Content="Importar macro"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Biblioteca" />
                    <TextBlock Margin="0,4,16,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Importa un .bas del catálogo, como Trim o Separar por columna. MacroX aplica esa operación y no ejecuta el código VBA."
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,0,0,8"
                       Style="{StaticResource SectionTitleTextStyle}"
                       Text="Añadidas desde archivo" />
            <TextBlock Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Todavía no has importado un .bas."
                       Visibility="{Binding HasNoImportedModules, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl Margin="0,0,0,16" ItemsSource="{Binding ImportedModules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="16"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSmall}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        AutomationProperties.Name="Eliminar macro"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Eliminar">
                                    <TextBlock FontFamily="{StaticResource FontFamilyIcons}"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </Button>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding FileName}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource FocusBrush}"
                                               Text="{Binding Summary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,0,0,8"
                       Style="{StaticResource SectionTitleTextStyle}"
                       Text="Catálogo" />
            <TextBlock Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="No hay macros en el catálogo. Puedes volver a mostrar las que quitaste."
                       TextWrapping="Wrap"
                       Visibility="{Binding HasNoMacros, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Command="{Binding RestoreMacrosCommand}"
                    Content="Restaurar macros"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding HasNoMacros, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSmall}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        AutomationProperties.Name="Quitar macro"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Quitar de la biblioteca">
                                    <TextBlock FontFamily="{StaticResource FontFamilyIcons}"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </Button>
                                <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource FocusBrush}"
                                           Text="{Binding Category}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding SourceNote}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ContentControl>
</UserControl>
