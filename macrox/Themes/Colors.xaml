<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Paleta Dark Glass de MacroX.
         Monocromática: negros violáceos, morado profundo y un solo
         acento violeta. Sin colores secundarios.
         ============================================================ -->

    <!-- Superficies -->
    <Color x:Key="PageBackgroundColor">#0B0614</Color>
    <Color x:Key="SurfaceColor">#14FFFFFF</Color>
    <Color x:Key="SurfaceStrongColor">#1AFFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#1FFFFFFF</Color>
    <Color x:Key="BorderColor">#26FFFFFF</Color>
    <Color x:Key="GlassHighlightColor">#38FFFFFF</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#F5F3FF</Color>
    <Color x:Key="TextSecondaryColor">#C7BFD6</Color>
    <Color x:Key="TextMutedColor">#8F86A3</Color>

    <!-- Acento único -->
    <Color x:Key="AccentColor">#8B5CF6</Color>
    <Color x:Key="AccentHoverColor">#A78BFA</Color>
    <Color x:Key="AccentDeepColor">#7C3AED</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="AccentSoftColor">#337C3AED</Color>
    <Color x:Key="FocusColor">#C4B5FD</Color>

    <!-- Barra lateral de cristal -->
    <Color x:Key="SidebarBackgroundColor">#CC0E0818</Color>
    <Color x:Key="SidebarForegroundColor">#EDE9FE</Color>
    <Color x:Key="SidebarMutedColor">#A79FBB</Color>
    <Color x:Key="SidebarHoverColor">#1AFFFFFF</Color>
    <Color x:Key="SidebarSelectedColor">#3D7C3AED</Color>
    <Color x:Key="SidebarSelectedForegroundColor">#FFFFFF</Color>

    <!-- Pinceles -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{StaticResource SurfaceStrongColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource GlassHighlightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="{StaticResource SidebarSelectedForegroundColor}" />

    <!-- Fondo: degradado violáceo profundo -->
    <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0B0614" />
        <GradientStop Offset="0.55" Color="#150A26" />
        <GradientStop Offset="1" Color="#1E0F35" />
    </LinearGradientBrush>

    <!-- Dos resplandores del mismo tono, muy contenidos -->
    <RadialGradientBrush x:Key="PurpleGlowBrush">
        <GradientStop Offset="0" Color="#4D7C3AED" />
        <GradientStop Offset="1" Color="#007C3AED" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="DeepPurpleGlowBrush">
        <GradientStop Offset="0" Color="#336D28D9" />
        <GradientStop Offset="1" Color="#006D28D9" />
    </RadialGradientBrush>

    <!-- Formas y espaciados reutilizables -->
    <CornerRadius x:Key="CornerRadiusSmall">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

    <Thickness x:Key="PagePadding">24,8,28,0</Thickness>
    <Thickness x:Key="CardPadding">32</Thickness>

</ResourceDictionary>
