<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         MacroX · Dark Glass / Azure & Emerald
         Dos acentos con roles distintos: azul para navegación y
         acciones; verde para estado, confirmación y resultados.
         La base neutra mantiene el cristal oscuro sin sesgo.
         ============================================================ -->

    <!-- Canvas y superficies de vidrio -->
    <Color x:Key="CanvasColor">#060910</Color>
    <Color x:Key="SidebarSurfaceColor">#BF0A0F1A</Color>
    <Color x:Key="CardSurfaceColor">#73141D2B</Color>
    <Color x:Key="FooterSurfaceColor">#990A0F1A</Color>
    <Color x:Key="RimLightColor">#24A7D0F3</Color>
    <Color x:Key="InnerHighlightColor">#1FFFFFFF</Color>
    <Color x:Key="NavigationHoverColor">#0AFFFFFF</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#F4F7FC</Color>
    <Color x:Key="TextSecondaryColor">#8FA0B3</Color>
    <Color x:Key="TextMutedColor">#526478</Color>

    <!-- Acento primario: azul · navegación y acciones -->
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentForegroundColor">#061024</Color>
    <Color x:Key="AccentSoftColor">#263B82F6</Color>
    <Color x:Key="AccentBorderColor">#4D60A5FA</Color>
    <Color x:Key="FocusColor">#93C5FD</Color>

    <!-- Acento secundario: verde · estado y confirmación -->
    <Color x:Key="SecondaryAccentColor">#10B981</Color>
    <Color x:Key="SecondaryAccentHoverColor">#34D399</Color>
    <Color x:Key="SecondaryAccentSoftColor">#2610B981</Color>
    <Color x:Key="SecondaryAccentBorderColor">#4D34D399</Color>

    <!-- Barra lateral -->
    <Color x:Key="SidebarForegroundColor">#F4F7FC</Color>
    <Color x:Key="SidebarMutedColor">#8FA0B3</Color>

    <!-- Pinceles base -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="{StaticResource SidebarSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="FooterSurfaceBrush" Color="{StaticResource FooterSurfaceColor}" />
    <SolidColorBrush x:Key="RimLightBrush" Color="{StaticResource RimLightColor}" />
    <SolidColorBrush x:Key="InnerHighlightBrush" Color="{StaticResource InnerHighlightColor}" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="{StaticResource NavigationHoverColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource SecondaryAccentHoverColor}" />
    <SolidColorBrush x:Key="SecondaryAccentSoftBrush" Color="{StaticResource SecondaryAccentSoftColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBorderBrush" Color="{StaticResource SecondaryAccentBorderColor}" />

    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />

    <!-- Orbes de iluminación ambiental: azul arriba, verde abajo -->
    <SolidColorBrush x:Key="OrbPrimaryBrush" Color="#2E3B82F6" />
    <SolidColorBrush x:Key="OrbSecondaryBrush" Color="#5910B981" />

    <!-- Ítem de navegación activo: degradado azul -->
    <LinearGradientBrush x:Key="ActiveNavigationBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2E3B82F6" />
        <GradientStop Offset="1" Color="#053B82F6" />
    </LinearGradientBrush>

    <!-- Divisoria: transición azul → verde, transparente en los extremos -->
    <LinearGradientBrush x:Key="DividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#003B82F6" />
        <GradientStop Offset="0.35" Color="#603B82F6" />
        <GradientStop Offset="0.65" Color="#6010B981" />
        <GradientStop Offset="1" Color="#0010B981" />
    </LinearGradientBrush>

    <!-- Formas -->
    <CornerRadius x:Key="CornerRadiusFooter">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

    <Thickness x:Key="CardPadding">32</Thickness>

</ResourceDictionary>
