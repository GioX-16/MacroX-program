<Window x:Class="macrox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:macrox.ViewModels"
        Title="{Binding ApplicationTitle, Mode=OneWay, FallbackValue=MacroX}"
        Icon="pack://application:,,,/Macrox_app_icon.ico"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource FontFamilyDefault}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- Render temporal de una sección. Se sustituirá por las vistas reales
             cuando existan las pantallas de la capa de aplicación. -->
        <DataTemplate DataType="{x:Type vm:NavigationSection}">
            <ContentControl VerticalAlignment="Top" Style="{StaticResource GlassCardStyle}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusSmall}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontFamilyIcons}"
                                   FontSize="22"
                                   Foreground="{StaticResource FocusBrush}"
                                   Text="{Binding Icon}" />
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Text="{Binding Title}" />

                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding Description}" />

                    <Border Height="1"
                            Margin="0,24,0,16"
                            Background="{StaticResource DividerBrush}" />

                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Esta sección todavía no tiene contenido. La vista se conectará cuando la capa de aplicación exponga sus casos de uso." />
                </StackPanel>
            </ContentControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Iluminación ambiental: dos orbes difuminados detrás de los paneles -->
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Width="640"
                     Height="640"
                     Margin="0,-220,-150,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{StaticResource OrbPrimaryBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="120" RenderingBias="Performance" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="780"
                     Height="780"
                     Margin="-340,40,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Fill="{StaticResource OrbSecondaryBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="120" RenderingBias="Performance" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral: cristal denso con divisor derecho -->
            <Border Grid.Column="0" Style="{StaticResource GlassSidebarStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,24,20,20" Orientation="Horizontal">
                        <Image Width="56"
                               Height="36"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="MacroX"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/Macrox_logo.png"
                               Stretch="Uniform" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BrandTextStyle}"
                                       Text="{Binding ApplicationTitle, Mode=OneWay}" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource SidebarCaptionTextStyle}"
                                       Text="{Binding ApplicationSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}"
                             ItemsSource="{Binding Sections, Mode=OneTime}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             Style="{StaticResource NavigationListBoxStyle}"
                             TabIndex="0" SelectionChanged="ListBox_SelectionChanged" />

                    <StackPanel Grid.Row="2" Margin="24,16,24,24">
                        <Border Height="1" Background="{StaticResource DividerBrush}" />
                        <TextBlock Margin="0,14,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Ejecución local" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding DisplayVersion, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área de contenido -->
            <Grid Grid.Column="1" Margin="28,22,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,0,8,20">
                    <TextBlock AutomationProperties.HeadingLevel="Level1"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="{Binding SelectedSection.Title, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               Text="{Binding SelectedSection.Description, Mode=OneWay}" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             AutomationProperties.LiveSetting="Polite"
                             Style="{StaticResource BusyProgressBarStyle}"
                             Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,4,8,20"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    AutomationProperties.Name="{Binding SelectedSection.Title, Mode=OneWay}"
                                    Content="{Binding SelectedSection, Mode=OneWay}" />
                </ScrollViewer>

                <Border Grid.Row="3"
                        Margin="8,8,8,0"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource GlassFooterStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                            <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding StatusMessage, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Datos locales · Sin conexión externa" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
